{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["record_id", "source", "value"],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,80}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "[A-Za-z0-9]"
    },
    "value": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    }
  }
}
