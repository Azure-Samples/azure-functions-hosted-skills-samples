{
  "version": "2.0",
  "functionTimeout": "00:15:00",
  "logging": {
    "logLevel": {
      "default": "Information"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "messageEncoding": "none",
      "maxDequeueCount": 5,
      "batchSize": 4
    },
    "eventHubs": {
      "maxEventBatchSize": 100,
      "minEventBatchSize": 20,
      "maxWaitTime": "00:00:10",
      "batchCheckpointFrequency": 1
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
