{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "briefingSchedule": {
      "value": "${BRIEFING_SCHEDULE=0 0 13 * * 1-5}"
    },
    "briefingTimeZone": {
      "value": "${BRIEFING_TIMEZONE=America/New_York}"
    },
    "enableOffice365": {
      "value": "${ENABLE_OFFICE365=false}"
    }
  }
}
